{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Telembro",
  "version": "0.1.2",
  "identifier": "com.telembro.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Telembro",
        "width": 420,
        "height": 600,
        "minWidth": 400,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "center": true,
        "backgroundColor": "#faf9f6"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Pequenos lembretes sobre seus aplicativos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "languages": ["PortugueseBR"],
        "installMode": "currentUser"
      }
    }
  }
}
