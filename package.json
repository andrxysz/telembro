{
  "name": "telembro",
  "private": true,
  "version": "0.1.2",
  "description": "Pequenos lembretes, mais espaço na cabeça.",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/native.ps1 build",
    "format": "prettier --write src *.ts *.json *.html README.md",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
